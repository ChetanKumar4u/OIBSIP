NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/oibsip_pizza
JWT_SECRET=

# Optional SMTP configuration. Without it in development, verification and reset
# links are printed to the API terminal for local testing.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_USERNAME=PizzaAdmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional Razorpay test credentials. Without them, the app provides an explicit
# local test-payment simulator; production startup requires real test/live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
