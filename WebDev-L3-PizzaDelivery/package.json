{
  "name": "oibsip-level-3-pizza-delivery",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server",
    "seed:admin": "npm run seed:admin --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
